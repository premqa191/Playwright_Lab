import heapq

class MedianFinder:
    def __init__(self):
        self.small = []  # Max-Heap (stores negative numbers)
        self.large = []  # Min-Heap

    def add_num(self, num: int) -> None:
        heapq.heappush(self.small, -num)

        if self.small and self.large and (-self.small[0] > self.large[0]):
            val = -heapq.heappop(self.small)
            heapq.heappush(self.large, val)

        if len(self.small) > len(self.large) + 1:
            val = -heapq.heappop(self.small)
            heapq.heappush(self.large, val)
        elif len(self.large) > len(self.small):
            val = heapq.heappop(self.large)
            heapq.heappush(self.small, -val)

    def find_median(self) -> float:
        if len(self.small) > len(self.large):
            return float(-self.small[0])
        return (-self.small[0] + self.large[0]) / 2.0

if __name__ == "__main__":
    mf = MedianFinder()
    mf.add_num(1)
    assert mf.find_median() == 1.0

    mf.add_num(2)
    assert mf.find_median() == 1.5

    mf.add_num(3)
    assert mf.find_median() == 2.0

    mf.add_num(4)
    assert mf.find_median() == 2.5

    mf2 = MedianFinder()
    for n in [-1, -2, -3, -4, -5]:
        mf2.add_num(n)
    assert mf2.find_median() == -3.0

    print("All Find Median from Data Stream assertions passed successfully with Two-Heap Architecture!")
